{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bgs-chronicles-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "PILOT_ENABLED": "false",
    "FREE_TIER_VERIFIED": "false",
    "GEMINI_MODEL": "gemini-3.1-flash-lite"
  },
  "secrets": { "required": ["GEMINI_API_KEY"] },
  "durable_objects": {
    "bindings": [{ "name": "QUOTA", "class_name": "PilotQuota" }]
  },
  "migrations": [
    { "tag": "bgs-ai-quota-v1", "new_sqlite_classes": ["PilotQuota"] }
  ]
}
